{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minerva Harness",
  "version": "0.1.0",
  "identifier": "ru.oestudio.rig.prototype",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Minerva Harness",
        "width": 1280,
        "height": 860,
        "minWidth": 700,
        "minHeight": 550
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
